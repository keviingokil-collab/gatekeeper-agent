# Proof Gatekeeper agent — environment template.
# Copy to .env and fill in the real values. NEVER commit a filled-in .env,
# and never paste a private key, seed phrase, or API key into a chat or a
# prompt. Secrets come only from the environment.

# --- REQUIRED ---
# The platform-generated HMAC secret. Dashboard -> Rotate Secret, copy the
# one-time plaintext. The server refuses to start without it and never
# accepts a placeholder.
AGENT_GAMES_HMAC_SECRET=

# --- Server ---
PORT=3000
# Hard deadline per request (ms). The platform enforces 60s; keep this at
# 60000 in production. On a very slow host you may raise it for local
# testing only — the platform will still time out at 60s.
REQUEST_TIMEOUT_MS=60000
# Allowed clock skew for a task's issued_at in the future (ms). Default 5 min.
TIMESTAMP_SKEW_MS=300000

# --- Circuit (defaults point at the downloaded artifacts) ---
GATEKEEPER_VK_HASH=0x6b79c6012a6d8651f3e13bc4d2a20370280ab49700c90c5316d4168bfbad77b0
CIRCUIT_WASM_PATH=circuits/gatekeeper.wasm
CIRCUIT_ZKEY_PATH=circuits/gatekeeper_final.zkey
VERIFICATION_KEY_PATH=circuits/verification_key.json

# --- Kurier (zkVerify REST verification) ---
# Keep "false" for local development / tests. Set "true" in production once
# you have a Kurier API key (mainnet). The gatekeeper vk is already
# registered on mainnet, so no register-vk call is needed (vkRegistered: true).
KURIER_ENABLED=false
KURIER_API_KEY=
# Mainnet: https://api.kurier.xyz/api/v1
# Testnet: https://api-testnet.kurier.xyz/api/v1
KURIER_API_URL=https://api.kurier.xyz/api/v1
KURIER_POLL_INTERVAL_MS=5000
# Must stay below REQUEST_TIMEOUT_MS so polling can never push a response
# past the deadline. Kurier failure never changes the decision.
KURIER_POLL_TIMEOUT_MS=30000

# --- Replay store (proof_tx seen-set, persisted as JSON) ---
SEEN_STORE_PATH=data/seen.json
